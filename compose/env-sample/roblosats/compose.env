STATIC='/srv/roblosats/<alias>-data/static'
DATABASE='/srv/roblosats/<alias>-data/database'
PG_BACKUP='/srv/roblosats/<alias>-data/pg_backup'
ROBOSATS_ENVS_FILE='env/<alias>/robosats.env'
SUFFIX='-<alias>'
NETWORK='mainnet'
POSTGRES_NAME='roblosats'
POSTGRES_USER='roblosats'
POSTGRES_PASSWORD='<random, same as robosats.env>'
NGINX_CONFD='./env/<alias>/nginx'
WELLKNOWN='./nginx/mn.well-known'
RELAY_CONF='./env/<alias>/relay.strfry.conf'
RELAY_URLS_EXTERNAL='./env/<alias>/relay.external_urls.txt'
RELAY_URLS_FEDERATION='./env/<alias>/relay.federation_urls.txt'
RELAY_DATA='/srv/roblosats/<alias>-data/relay'
WEB_LOCAL_PORT=12597
GUNICORN_WORKERS=3
TOR_DATA='./env/<alias>/tor'
TOR_CONFIG='./env/<alias>/torrc'
ROBOSATS_TAG=unused
# Only to satisfy the base compose; these services are disabled (profile "unused").
BLOSSOM_CONFIG=/dev/null
BLOSSOM_DATA=/tmp/unused
BITCOIN_DATA=/tmp/unused
BITCOIN_CONF=/dev/null
GUEST_BITCOIN=/tmp/unused
LND_DATA=/tmp/unused
LND_CONF=/dev/null
LIT_DATA=/tmp/unused
BU_DIR1=/tmp/unused
BU_DIR2=/tmp/unused
BU_DIR3=/tmp/unused
ROBLOSATS_TAG=0.8.7-rl6
