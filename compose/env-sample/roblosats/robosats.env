# Roblosats coordinator settings (template; values are Kilobot's). Copy to env/<alias>/robosats.env, chmod 600.
COORDINATOR_ALIAS="<YourAlias>"
LNVENDOR='LND'
LND_CERT_BASE64='<base64 of your LND tls.cert>'
LND_MACAROON_BASE64='<base64 of your LND admin.macaroon>'
LND_GRPC_HOST='<lnd host>:10009'
BITCOIND_RPCURL = 'http://<blake2b node host>:8332'
BITCOIND_RPCUSER = '<rpc user>'
BITCOIND_RPCPASSWORD = '<rpc password>'
REDIS_URL='redis://localhost:6379/1'
POSTGRES_DB='roblosats'
POSTGRES_USER='roblosats'
POSTGRES_PASSWORD='<random, same as compose.env>'
POSTGRES_HOST='127.0.0.1'
POSTGRES_PORT='5432'
USE_TOR='True'
TOR_PROXY='127.0.0.1:9050'
STRFRY_HOST = 'localhost'
STRFRY_PORT = '7778'
# BTCB2 price from two venues, NonKYC and Neoxa (order-book midpoints), fiat via yadio.
# These go through mempool.kilombino.com, run by the Roblosats maintainer, because both
# venues block Tor exits: you trust that server with your price. With clearnet access,
# point straight at the venues instead:
#   MARKET_PRICE_APIS = 'https://api.nonkyc.io/api/v2/ticker/BTCB2_USDT'
#   NEOXA_TICKER_URL = 'https://neoxa.exchange/api/exchange/ticker/BTCB2_USDC'
MARKET_PRICE_APIS = 'https://mempool.kilombino.com/nonkyc-ticker'
NEOXA_TICKER_URL = 'https://mempool.kilombino.com/neoxa-ticker'
MEMPOOL_FEES_URL = 'https://mempool.kilombino.com'
# 0.9.10: lowest sat/vB of an onchain swap payout (LND sends whole sat/vB)
#PAYOUT_MIN_FEE_RATE = 1
# 0.9.10: your clearnet web client's order pages, if you have one (the order id is added); the
# robots' notices carry this link next to the onion one. Empty = no clearnet link.
#CLEARNET_ORDER_URL = https://example.com/order/<shortalias>
HOST_NAME = '<yourvanity...onion>'
HOST_NAME2 = '<clearnet host or *>'
I2P_ALIAS = ''
I2P_LONG = ''
LOCAL_ALIAS = '<LAN ip of the server>'
ONION_LOCATION = '<yourvanity...onion>'
GEOBLOCKED_COUNTRIES = ''
ALTERNATIVE_SITE = ''
ALTERNATIVE_NAME = ''
SECRET_KEY = '<random 64 chars>'
TELEGRAM_TOKEN = '<your bot token from @BotFather>'
TELEGRAM_BOT_NAME = '<YourBot_bot>'
TELEGRAM_COORDINATOR_CHAT_ID = '<your telegram user id>'
CHAT_NOTIFICATION_TIMEGAP = 5
NOTICE_SEVERITY = 'none'
NOTICE_MESSAGE = ''
NETWORK = 'mainnet'
NODE_ALIAS = '<YourAlias>'
NODE_ID = '<your LN node pubkey>'
# Fees and bond as Ammanaya (percentages); limits in sats of this chain (~1/100 the value).
FEE = 0.0019
MAKER_FEE_SPLIT = 0.105
# Fraction of each successful order's proceeds donated by keysend to the Roblosats maintainer's node
# (optional; 0.2 or more earns the DevFund badge and a better place in the web's coordinator draw).
DEVFUND = 0
# Node that receives the devfund keysend. Empty: the image's devfund_pubkey.json (the Roblosats
# maintainer's node). Nothing is fetched at runtime.
DEVFUND_PUBKEY =
# From RoboSats v0.8.8: part of the devfund donation (0-1) paid to a Lightning Address instead.
# It must be an address on the BLAKE2b chain's Lightning network; leave it at 0 otherwise.
DEVFUND_COMMUNITY = 0
DEVFUND_COMMUNITY_ADDRESS =
MAX_PUBLIC_ORDERS = 100
MIN_ORDER_SIZE = 101000
MAX_ORDER_SIZE = 6000000
PENALTY_TIMEOUT = 60
RETRY_TIME = 1
# BLAKE2b blocks average ~9 min and hashrate is rentable: timelocks sized for 3x faster blocks.
BLOCK_TIME = 6
MAX_MINING_NETWORK_SPEEDUP_EXPECTED = 2.0
EXP_MAKER_BOND_INVOICE = 300
EXP_TAKER_BOND_INVOICE = 200
PROPORTIONAL_ROUTING_FEE_LIMIT = 0.001
MIN_FLAT_ROUTING_FEE_LIMIT_REWARD = 2
REWARDS_TIMEOUT_SECONDS = 30
PAYOUT_TIMEOUT_SECONDS = 90
DEBUG_PERMISSIONED_PAYOUTS = False
ALLOW_SELF_KEYSEND = False
# Buyers may take their sats on-chain (reverse swap from the coordinator's on-chain wallet).
DISABLE_ONCHAIN = False
SWAP_FEE_SHAPE = 'exponential'
SWAP_LAMBDA = 8.8
MIN_SWAP_FEE = 0.008
MAX_SWAP_FEE = 0.1
MIN_SWAP_AMOUNT = 101000
MAX_SWAP_AMOUNT = 6000000
SPEND_UNCONFIRMED = False
SUGGESTED_TARGET_CONF = 4
MINIMUM_TARGET_CONF = 24
SLASHED_BOND_REWARD_SPLIT = 0.5
ESCROW_USERNAME = 'admin'
DISABLE_ORDER_LOGS = False
NOSTR_NSEC = '<nsec1... of your coordinator>'
# 0.9.11: seconds an order that left the book (expired, cancelled, taken) keeps its replacement event
#NOSTR_CLOSED_EVENT_TTL = 3600
CSRF_TRUSTED_ORIGINS = 'http://<lan ip>:<port>,http://<onion>,https://<clearnet host>'
# Used only if no venue answers and there is no stored price yet; update it then.
BTCB2_FALLBACK_USD = 800
# With fewer than this many venues answering (or two that disagree by >10 %), the last
# stored price is kept. 1 = follow a single venue (not recommended).
#BTCB2_MIN_VENUES = 2
# ...but only for this many seconds since the last refresh with both venues agreeing; then
# the remaining (or closer) venue is followed again, at most BTCB2_MAX_STEP (5 %) per refresh.
#BTCB2_SINGLE_VENUE_GRACE = 3600

# Payout safety (optional; Kilobot's values).
#REWARD_WITHDRAW_COOLDOWN = 86400
#REWARD_WITHDRAW_GLOBAL_DAILY_MAX = 500000
#PAYOUT_MAX_SATS = 6000000

# Time zone the admin panel shows times in (the database stays in UTC).
ADMIN_TIME_ZONE=UTC

# ---------------------------------------------------------------------------------------------
# On-chain escrow (Roblosats 0.9.0; optional, OFF by default). Leave ONCHAIN_ESCROW = False to
# stay Lightning-only: /api/info then does not announce it and the apps hide every on-chain
# option. See "On-chain escrow" in COORDINATOR.md before turning it on.
ONCHAIN_ESCROW = False
# 32 random bytes in hex (openssl rand -hex 32). Your escrow and bond keys are derived from it and
# from COORDINATOR_ALIAS: back it up with your onion and Nostr keys, never change either while an
# on-chain order is open.
#ESCROW_SECRET = '<64 hex characters>'
# Your own address on the BLAKE2b chain: coordinator fees and bond penalties are paid to it.
#ESCROW_COORDINATOR_ADDRESS = '<bc1... address of your wallet>'
# Watch-only descriptor wallet the server creates on the node of BITCOIND_RPCURL (wallet support
# on, the RPC user allowed to use wallets) to follow bonds and deposits.
#ESCROW_WATCH_WALLET = 'roblosats-escrow'
# Sizes of on-chain orders, in sats (default MIN_ORDER_SIZE / MAX_ORDER_SIZE). Start small.
#ESCROW_MIN_SATS = 20000
#ESCROW_MAX_SATS = 101000
# Blocks after the deposit confirms before the two traders can use their pre-signed rescue
# without you (2016 = about two weeks at 10 minutes, less on this chain).
#ESCROW_RESCUE_CSV = 2016
# Seconds each side has to pay its bond / fund the deposit.
#ESCROW_BOND_SECONDS = 10800
#ESCROW_FUNDING_SECONDS = 10800
# '' = every robot can make and take on-chain orders. A comma list (nicknames, hash ids or Nostr
# keys) keeps them private to those robots, for testing.
#ESCROW_ALLOWED_ROBOTS = ''
# Smallest coordinator fee per completed on-chain trade, in sats (one output, never dust).
#ESCROW_MIN_COORDINATOR_FEE_SATS = 1000
# Optional share of your on-chain fees for development, to an address you choose (off unless both).
#ESCROW_DEV_FEE_PERCENT = 0
#ESCROW_DEV_ADDRESS = ''
# Mining fee of a bond penalty: sat/vB, its floor, and a cap as % of the bond.
#ESCROW_PENALTY_FEE_RATE = 10
#ESCROW_PENALTY_MIN_FEE_RATE = 1
#ESCROW_PENALTY_MAX_FEE_PCT = 10
# Mining fee range of the pre-signed rescue, sat/vB.
#ESCROW_RESCUE_MIN_FEE_RATE = 2
#ESCROW_RESCUE_MAX_FEE_RATE = 20
# Lowest fee rate of the deposit, sat/vB (0.9.3). The deposit is planned at the current rate; when a
# trader's funding (the amount it was shown) falls a little short of that, it pays the highest rate
# the funding covers, down to this floor, instead of asking the trader to pay again.
#ESCROW_MIN_DEPOSIT_FEE_RATE = 1
# 0.9.11: fee ladder of the automatic bond return (sat/vB below the penalty's rate), the blocks the
# cheapest rung must confirm in, and how long before the next rung replaces a stuck one
#ESCROW_AUTO_RETURN_RATES = 1,3
#ESCROW_AUTO_RETURN_TARGET_BLOCKS = 6
#ESCROW_AUTO_RETURN_BUMP_SECONDS = 7200
# On-chain orders can also be taken with Lightning (hybrid); the buyer's fee comes out of its bond.
#ESCROW_LIGHTNING_TAKER = True
#ESCROW_BUYER_FEE_FROM_BOND = True
