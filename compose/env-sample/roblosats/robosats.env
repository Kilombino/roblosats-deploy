# Roblosats coordinator settings (template; values are Kilobot's). Copy to env/<alias>/robosats.env, chmod 600.
COORDINATOR_ALIAS="<YourAlias>"
LNVENDOR='LND'
LND_CERT_BASE64='<base64 of your LND tls.cert>'
LND_MACAROON_BASE64='<base64 of your LND admin.macaroon>'
LND_GRPC_HOST='<lnd host>:10009'
BITCOIND_RPCURL = 'http://<blake2b node host>:8332'
BITCOIND_RPCUSER = '<rpc user>'
BITCOIND_RPCPASSWORD = '<rpc password>'
REDIS_URL='redis://localhost:6379/1'
POSTGRES_DB='roblosats'
POSTGRES_USER='roblosats'
POSTGRES_PASSWORD='<random, same as compose.env>'
POSTGRES_HOST='127.0.0.1'
POSTGRES_PORT='5432'
USE_TOR='True'
TOR_PROXY='127.0.0.1:9050'
STRFRY_HOST = 'localhost'
STRFRY_PORT = '7778'
# BTCB2 price from Neoxa through mempool.kilombino.com (reachable over Tor), fiat via yadio.
MARKET_PRICE_APIS = 'https://mempool.kilombino.com/neoxa-ticker'
MEMPOOL_FEES_URL = 'https://mempool.kilombino.com'
HOST_NAME = '<yourvanity...onion>'
HOST_NAME2 = '<clearnet host or *>'
I2P_ALIAS = ''
I2P_LONG = ''
LOCAL_ALIAS = '<LAN ip of the server>'
ONION_LOCATION = '<yourvanity...onion>'
GEOBLOCKED_COUNTRIES = ''
ALTERNATIVE_SITE = ''
ALTERNATIVE_NAME = ''
SECRET_KEY = '<random 64 chars>'
TELEGRAM_TOKEN = '<your bot token from @BotFather>'
TELEGRAM_BOT_NAME = '<YourBot_bot>'
TELEGRAM_COORDINATOR_CHAT_ID = '<your telegram user id>'
CHAT_NOTIFICATION_TIMEGAP = 5
NOTICE_SEVERITY = 'none'
NOTICE_MESSAGE = ''
NETWORK = 'mainnet'
NODE_ALIAS = '<YourAlias>'
NODE_ID = '<your LN node pubkey>'
# Fees and bond as Ammanaya (percentages); limits in sats of this chain (~1/100 the value).
FEE = 0.0019
MAKER_FEE_SPLIT = 0.105
DEVFUND = 0
MAX_PUBLIC_ORDERS = 100
MIN_ORDER_SIZE = 101000
MAX_ORDER_SIZE = 6000000
PENALTY_TIMEOUT = 60
RETRY_TIME = 1
BLOCK_TIME = 8
MAX_MINING_NETWORK_SPEEDUP_EXPECTED = 1.7
EXP_MAKER_BOND_INVOICE = 300
EXP_TAKER_BOND_INVOICE = 200
PROPORTIONAL_ROUTING_FEE_LIMIT = 0.001
MIN_FLAT_ROUTING_FEE_LIMIT_REWARD = 2
REWARDS_TIMEOUT_SECONDS = 30
PAYOUT_TIMEOUT_SECONDS = 90
DEBUG_PERMISSIONED_PAYOUTS = False
ALLOW_SELF_KEYSEND = False
# Buyers may take their sats on-chain (reverse swap from the coordinator's on-chain wallet).
DISABLE_ONCHAIN = False
SWAP_FEE_SHAPE = 'exponential'
SWAP_LAMBDA = 8.8
MIN_SWAP_FEE = 0.008
MAX_SWAP_FEE = 0.1
MIN_SWAP_AMOUNT = 101000
MAX_SWAP_AMOUNT = 6000000
SPEND_UNCONFIRMED = False
SUGGESTED_TARGET_CONF = 4
MINIMUM_TARGET_CONF = 24
SLASHED_BOND_REWARD_SPLIT = 0.5
ESCROW_USERNAME = 'admin'
DISABLE_ORDER_LOGS = False
NOSTR_NSEC = '<nsec1... of your coordinator>'
CSRF_TRUSTED_ORIGINS = 'http://<lan ip>:<port>,http://<onion>,https://<clearnet host>'
# Used only if Neoxa stops answering (the watcher warns on Telegram); update it then.
BTCB2_FALLBACK_USD = 800

# Time zone the admin panel shows times in (the database stays in UTC).
ADMIN_TIME_ZONE=UTC
